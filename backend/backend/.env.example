# ==================================================
# LearnSphere AI - Backend Environment Configuration
# ==================================================

# Application Environment ('development' or 'production')
ENVIRONMENT=development

# Database (PostgreSQL)
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/learnsphere

# Authentication & Security (Phase 6A)
# Mandatory in production: random 32+ character secret string
JWT_SECRET_KEY=generate_a_cryptographically_secure_random_key_min_32_characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# LLM Provider Configuration
# Supported providers: openai, groq, ollama
# Note: LLM_API_KEY is required for 'openai' and 'groq'.
# For OpenAI: LLM_PROVIDER=openai, LLM_MODEL=gpt-4o-mini, LLM_API_KEY=your_openai_api_key_here
# For Groq:   LLM_PROVIDER=groq, LLM_MODEL=qwen/qwen3.8-27b (or llama-3.3-70b-versatile), LLM_API_KEY=your_groq_api_key_here
# For Ollama: LLM_PROVIDER=ollama, LLM_MODEL=llama3, LLM_BASE_URL=http://localhost:11434/v1 (no key required)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your_llm_api_key_here
# Optional custom endpoint (e.g., http://localhost:11434/v1 for Ollama)
LLM_BASE_URL=

# Embedding Provider Configuration
# Supported providers: fastembed (offline, 0 API keys required), openai
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_API_KEY=

# Frontend Bolt.new CORS Integration
FRONTEND_URL=http://localhost:5173
# Additional allowed CORS origins (comma-separated, optional)
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Storage & Upload Limits
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# RAG & Grounding Parameters
RAG_TOP_K=4
RAG_SCORE_THRESHOLD=0.55

# Multimodal Vision Model Configuration (Phase 4A)
VISION_PROVIDER=groq
VISION_MODEL=qwen/qwen3.6-27b
VISION_API_KEY=your_vision_api_key_here
VISION_BASE_URL=
VISION_ENABLED=true

# Speech-to-Text Transcription Configuration (Phase 4B)
TRANSCRIPTION_PROVIDER=groq
TRANSCRIPTION_MODEL=whisper-large-v3-turbo
TRANSCRIPTION_LANGUAGE=
TRANSCRIPTION_API_KEY=your_groq_api_key_here
TRANSCRIPTION_BASE_URL=
TRANSCRIPTION_ENABLED=true
TRANSCRIPTION_MAX_FILE_MB=25
TRANSCRIPTION_CHUNK_SECONDS=600
TRANSCRIPTION_OVERLAP_SECONDS=5

