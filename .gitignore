# ==========================================
# LearnMate - Root Git Ignore Configuration
# ==========================================

# Environment variables & secrets (never commit)
.env
.env.local
.env.*.local
*.env
!.env.example
!**/.env.example

# Local databases & persistent vector stores (never commit)
*.db
*.sqlite
*.sqlite3
qdrant_storage/
**/qdrant_storage/

# Uploaded documents & user media (never commit)
uploads/*
**/uploads/*
!**/uploads/.gitkeep

# Python virtual environments & bytecode
.venv/
env/
venv/
ENV/
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & coverage
.pytest_cache/
**/.pytest_cache/
.coverage
htmlcov/

# Node & Frontend build artifacts
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
*.local
*.timestamp-*.mjs
**/vite.config.ts.timestamp-*.mjs

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE & Editor files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
